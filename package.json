{
  "name": "party-box",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 45321",
    "relay": "node server/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 45321",
    "test:relay": "node scripts/check-relay.mjs",
    "test:relay-persist": "node scripts/test-relay-persist.mjs",
    "test:e2e-relay-restart": "node scripts/e2e-relay-restart.mjs",
    "test:transfer": "node scripts/test-transfer.mjs",
    "test:buyin": "node scripts/test-buyin.mjs",
    "test:undo": "node scripts/test-undo.mjs",
    "test:pot": "node scripts/test-pot.mjs",
    "test:stale-sync": "node --experimental-strip-types scripts/test-stale-sync.mjs",
    "test:settlement": "node --experimental-strip-types scripts/test-settlement.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
