# Shared room relay (required for cross-device join).
# Local: npm run relay  →  http://127.0.0.1:45322
# Production: set to your deployed relay origin (https://…).
# Build-time bake for 稳预览验 — must be a fixed HTTPS origin (not trycloudflare).
VITE_RELAY_URL=http://127.0.0.1:45322

# Node relay durable dir (optional; default ./data)
# PARTY_BOX_DATA_DIR=/var/lib/party-box
